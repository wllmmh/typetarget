-                whisper_print_timings(g_contexts[index]);
-                if (is_multilingual) {
-                    free((void*)params.language);
-                }
-            });
+            whisper_reset_timings(g_contexts[index]);
+            whisper_full(g_contexts[index], params, pcmf32.data(), pcmf32.size());
+            whisper_print_timings(g_contexts[index]);
+            if (is_multilingual) {
+                free((void*)params.language);
+            }
         }
 
         return 0;
