-                whisper_print_timings(g_contexts[index]);
-                if (is_multilingual) {
-                    free((void*)params.language);
-                }
-            });
+            whisper_reset_timings(g_contexts[index]);
+            whisper_full(g_contexts[index], params, pcmf32.data(), pcmf32.size());
+            whisper_print_timings(g_contexts[index]);
+            if (is_multilingual) {
+                free((void*)params.language);
+            }
+        }
+
+        return 0;
+    }));
+
+    emscripten::function("full_opts", emscripten::optional_override([](size_t index, const emscripten::val & audio, const std::string & lang, int nthreads, bool translate, int audio_ctx, bool single_segment, bool no_timestamps, float temperature_inc, int max_tokens) {
+        if (g_worker.joinable()) {
+            g_worker.join();
+        }
+
+        --index;
+
+        if (index >= g_contexts.size()) {
+            return -1;
+        }
+
+        if (g_contexts[index] == nullptr) {
+            return -2;
+        }
+
+        struct whisper_full_params params = whisper_full_default_params(whisper_sampling_strategy::WHISPER_SAMPLING_GREEDY);
+        bool is_multilingual = whisper_is_multilingual(g_contexts[index]);
+
+        params.print_realtime   = true;
+        params.print_progress   = false;
+        params.print_timestamps = true;
+        params.print_special    = false;
+        params.translate        = translate;
+        params.language         = is_multilingual ? strdup(lang.c_str()) : "en";
+        // Single-threaded build (-s USE_PTHREADS=0): ggml must not try to spawn threads.
+        (void) nthreads;
+        params.n_threads        = 1;
+        params.offset_ms        = 0;
+        params.audio_ctx        = audio_ctx;
+        params.single_segment   = single_segment;
+        params.no_timestamps    = no_timestamps;
+        params.temperature_inc  = temperature_inc;
+        params.max_tokens       = max_tokens;
+        params.no_context       = true;
+
+        std::vector<float> pcmf32;
+        const int n = audio["length"].as<int>();
+
+        emscripten::val heap = emscripten::val::module_property("HEAPU8");
+        emscripten::val memory = heap["buffer"];
+
+        pcmf32.resize(n);
+
+        emscripten::val memoryView = audio["constructor"].new_(memory, reinterpret_cast<uintptr_t>(pcmf32.data()), n);
+        memoryView.call<void>("set", audio);
+
+        // print system information
+        {
+            printf("system_info: n_threads = %d / %d | %s\n",
+                    params.n_threads, std::thread::hardware_concurrency(), whisper_print_system_info());
+
+            printf("%s: processing %d samples, %.1f sec, %d threads, %d processors, lang = %s, task = %s ...\n",
+                    __func__, int(pcmf32.size()), float(pcmf32.size())/WHISPER_SAMPLE_RATE,
+                    params.n_threads, 1,
+                    params.language,
+                    params.translate ? "translate" : "transcribe");
+
+            printf("\n");
+        }
+
+        // Run inference synchronously. The upstream example detaches a std::thread here,
+        // which aborts outright in a no-pthreads build. Callers already treat the
+        // whisper_print_timings line on stderr as the completion signal, and it is printed
+        // before this returns, so blocking here is transparent to them.
+        {
+            whisper_reset_timings(g_contexts[index]);
+            whisper_full(g_contexts[index], params, pcmf32.data(), pcmf32.size());
+            whisper_print_timings(g_contexts[index]);
+            if (is_multilingual) {
+                free((void*)params.language);
+            }
         }
 
         return 0;
